FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     REPLACE_SOLVER;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         REPLACE_ENDTIME;
deltaT          REPLACE_DELTAT;

writeControl    timeStep;
writeInterval   REPLACE_WRITEINTERVAL;
purgeWrite      2;
writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

functions
{
    // Add function objects here (forceCoeffs, probes, etc.)
}
